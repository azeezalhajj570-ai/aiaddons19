<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="discuss_channel_rule_ai_chat_unlink_rule" model="ir.rule">
        <field name="name">discuss.channel: user can delete own ai chats</field>
        <field name="model_id" ref="mail.model_discuss_channel"/>
        <field name="domain_force">[('channel_type', '=', 'ai_chat'), ('is_member', '=', True)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read">0</field>
        <field name="perm_write">0</field>
        <field name="perm_create">0</field>
        <field name="perm_unlink">1</field>
    </record>
</odoo>

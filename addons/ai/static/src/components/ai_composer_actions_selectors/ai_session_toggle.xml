<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="ai.SessionToggle">
        <CheckboxItem
            checked="this.checked"
            closingMode="'none'"
            onSelected="() => this.toggle()"
        >
            <i t-if="this.props.icon" t-att-class="this.props.icon + ' me-2'"/>
            <span t-out="this.props.label"/>
        </CheckboxItem>
    </t>

</templates>
